# Server-side only. The browser bundle must never receive these values.
# Create a key in the Developer Center. Prepaid AI calls need the product:translate scope.
HIOBUY_API_KEY=

# Billing account for this App. Copy it from the App's HTTP example, or from GET /v1/ai/account.
# This is not an App ID, Workspace ID, or a domain you invent.
HIOBUY_AI_SHOP=

HIOBUY_API_BASE_URL=https://api.hiobuy.com
PORT=8790
